# --- Secrets: never commit -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Django ----------------------------------------------------------------
# db.sqlite3 itself is committed (P1-A4 deploys it); only its journal is not.
db.sqlite3-journal
staticfiles/
/media/
*.log

# --- Python ----------------------------------------------------------------
__pycache__/
*.pyc
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Virtual environments --------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- AI / model weights (P1-A6): never commit weights -----------------------
# Hugging Face downloads live in ~/.cache/huggingface, outside this repository.
# These patterns catch any copy that lands inside it.
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.gguf
*.onnx
*.h5
*.npz
models/
hf_cache/
llm-test/.cache/
.ipynb_checkpoints/
