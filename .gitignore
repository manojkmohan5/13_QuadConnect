# --- Secrets: never commit -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Django ----------------------------------------------------------------
# db.sqlite3 itself is committed (P1-A4 deploys it); only its journal is not.
db.sqlite3-journal
staticfiles/
/media/
*.log

# --- Python ----------------------------------------------------------------
__pycache__/
*.pyc
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Virtual environments --------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Model weights (P1-A6): never commit them -----------------------------
# transformers downloads weights into the Hugging Face cache, outside this
# repository; these catch any copy that lands inside it.
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.gguf
*.onnx
# A Hugging Face or sentence-transformers cache pointed inside the repository
# (HF_HOME, SENTENCE_TRANSFORMERS_HOME) is never committed either.
.cache/
hf_cache/
huggingface/
.ipynb_checkpoints/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
