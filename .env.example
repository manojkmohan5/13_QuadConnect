# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-50-character-random-string

# quadconnect.settings.development | quadconnect.settings.production
DJANGO_SETTINGS_MODULE=quadconnect.settings.development

# Comma-separated. Required when running production settings.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to 1 only behind real TLS: enables HSTS, SSL redirect, secure cookies.
DJANGO_SECURE_SSL=0

# Google sign-in (P1-A5): the OAuth client from Google Cloud Console
# (Google Auth Platform > Clients). Leave empty in development to hide
# "Continue with Google"; production settings refuse to start without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: where the database lives. Leave unset to use the committed
# db.sqlite3 (seed data). The live site keeps its own copy outside the
# repository, e.g. /home/<user>/quadconnect-data/db.sqlite3.
# DJANGO_DB_PATH=

# Third-party API keys. Dummy value is fine for coursework.
MAPS_API_KEY=dummy-maps-key-not-real

# --- AI features (P1-A6) -------------------------------------------------------
# Local Hugging Face model. Weights download automatically on the first request
# to /ai/profile-assistant/ (about 3 GB for the default). 0 = keyword matcher only.
LOCAL_LLM_ENABLED=1
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# bfloat16 (default) or float32 (faster on older CPUs, doubles the memory).
LOCAL_LLM_DTYPE=bfloat16

# External API for the welcome message: groq | gemini | openrouter.
# Free keys: https://console.groq.com/keys, https://aistudio.google.com/apikey,
# https://openrouter.ai/keys. Leave empty to use the built-in template instead.
AI_API_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: override the provider's default model.
# AI_API_MODEL=
