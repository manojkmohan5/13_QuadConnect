# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-50-character-random-string

# quadconnect.settings.development | quadconnect.settings.production
DJANGO_SETTINGS_MODULE=quadconnect.settings.development

# Comma-separated. Required when running production settings.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to 1 only behind real TLS: enables HSTS, SSL redirect, secure cookies.
DJANGO_SECURE_SSL=0

# Google sign-in (P1-A5): the OAuth client from Google Cloud Console
# (Google Auth Platform > Clients). Leave empty in development to hide
# "Continue with Google"; production settings refuse to start without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: where the database lives. Leave unset to use the committed
# db.sqlite3 (seed data). The live site keeps its own copy outside the
# repository, e.g. /home/<user>/quadconnect-data/db.sqlite3.
# DJANGO_DB_PATH=

# Optional: where profile photos are kept. Leave unset to use media/ in
# this folder (git ignores it). The live site keeps them outside the
# repository, like the database, e.g. /home/<user>/quadconnect-data/media.
# DJANGO_MEDIA_ROOT=

# Third-party API keys. Dummy value is fine for coursework.
MAPS_API_KEY=dummy-maps-key-not-real

# --- AI features (P1-A6, see README_AI.md) ---------------------------------
# Local model for "Ask in plain English" (/search/ask/). transformers downloads
# it on the first search (about 3 GB, into ~/.cache/huggingface). 0 = keyword
# parser only, no model.
AI_LOCAL_ENABLED=1
AI_LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# P1-A9: P1-A8's embedding model places an interest the model wrote in its own
# words ("Painting") on the list by meaning (Art). sentence-transformers
# downloads it on first use (about 130 MB, same cache). 0 = spelling only.
AI_EMBED_ENABLED=1
AI_EMBED_MODEL=BAAI/bge-small-en-v1.5

# External API that checks venue suggestions on /locations/: groq (default),
# openrouter, gemini or huggingface. Put the key for that provider below; with
# no key, suggestions are saved "not checked" and nothing is sent anywhere.
# Free keys: https://console.groq.com/keys
AI_API_PROVIDER=groq
GROQ_API_KEY=
# Optional: another model of the same provider.
# AI_API_MODEL=

# The same GROQ_API_KEY also runs the XL models in llm-test/ai_prototype.ipynb.
# Optional Hugging Face token: faster model downloads, and the key for
# AI_API_PROVIDER=huggingface.
HF_TOKEN=
