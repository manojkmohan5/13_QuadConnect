{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Matches each week",
    "subtitle": "Meetups scheduled in each weekly cycle",
    "anchor": "start"
  },
  "description": "Line chart of how many matches were scheduled in each weekly cycle, from the summer pilot to the current week.",
  "data": {
    "url": "/api/summary/matches-per-week/",
    "format": {"type": "json", "property": "records"}
  },
  "width": "container",
  "height": 260,
  "background": "white",
  "mark": {
    "type": "line",
    "color": "#ff5f05",
    "strokeWidth": 2.5,
    "point": {"filled": true, "size": 70, "color": "#ff5f05"}
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "ordinal",
      "timeUnit": "utcyearmonthdate",
      "title": "Week starting",
      "axis": {"format": "%b %d", "labelAngle": 0}
    },
    "y": {
      "field": "count",
      "type": "quantitative",
      "title": "Matches",
      "scale": {"domainMin": 0},
      "axis": {"tickMinStep": 1, "format": "d"}
    },
    "tooltip": [
      {"field": "date", "type": "temporal", "timeUnit": "utcyearmonthdate", "title": "Week starting", "format": "%b %d, %Y"},
      {"field": "count", "type": "quantitative", "title": "Matches"},
      {"field": "participants", "type": "quantitative", "title": "Participants"}
    ]
  },
  "config": {
    "font": "Figtree, Segoe UI, Arial, sans-serif",
    "view": {"stroke": null},
    "title": {"color": "#13294b", "subtitleColor": "#5e687d", "fontSize": 15},
    "axis": {"labelColor": "#13294b", "titleColor": "#13294b", "gridColor": "#e6e3dd", "domainColor": "#7c8597"}
  }
}
